# TaskMentor live-server (proctoring WebRTC signalling) — copy to .env.
# Only needed when working on the proctoring module.
NODE_ENV=development
# 5002 is the main API server; the client expects sockets on 5003.
PORT=5003
CORS_ORIGIN=http://localhost:5174
MAX_PARTICIPANTS_PER_ROOM=50
# Cloudflare TURN (optional; without it WebRTC only works on open networks)
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=
