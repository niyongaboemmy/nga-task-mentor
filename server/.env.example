# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=taskmentor_dev
DB_PORT=3306

# Server Configuration
PORT=5002
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development

# AI Provider Configuration
# PRIMARY: Google Gemini 1.5 Flash (Get key from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# SECONDARY: OpenAI (Use if Gemini fails or for specific models)
OPENAI_API_KEY=your_openai_api_key_here

# PROVIDER OVERRIDE (Optional: gemini | openai | mock)
AI_PRIMARY_PROVIDER=gemini

# MIS API Configuration
MIS_API_URL=http://localhost:5001
MIS_API_TOKEN=your_mis_token_here
