# TaskMentor server — copy to .env and fill in. NEVER commit the real .env.

# Database (local MySQL 8). Create `taskmentor_dev` first — see README.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=taskmentor_dev
DB_PORT=3306

# Server
PORT=5002
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development
TZ=UTC
# The Vite dev server (CORS + links back to the app)
FRONTEND_URL=http://localhost:5174
APP_PUBLIC_URL=http://localhost:5174

# ── NGA Central MIS: the only place anyone signs in ──
# start.bat runs a private copy of the Central MIS on this machine (its
# `npm run db:setup` seeds the admin login and registers this client with the
# secret below). These values only exist in that local database, so they are
# safe to commit and there is nothing to paste. The production client and its
# secret live in GitHub Actions and are never in this repo.
NGA_MIS_BASE_URL=http://localhost:5001
SSO_CLIENT_ID=taskmentor_app
SSO_CLIENT_SECRET=local-dev-secret-taskmentor_app
# Platform usage analytics (/api/activity relay -> MIS /activity/ingest) uses the
# three values above; without them it is a no-op. MIS must list this SSO_CLIENT_ID
# in its ACTIVITY_SOURCE_CLIENTS. SPA origins allowed to send public-page batches:
# ACTIVITY_ORIGINS=https://taskmentor.amashuri.com,http://localhost:5174
# Push quizzes/assignments to the MIS Reminder Hub (uses the SSO client
# credentials above as HTTP Basic). On by default; set to false to stop it.
REMINDERS_SYNC=true

# Daily early-warning signals to the MIS (PUT /early-warning/signals, same
# credentials): work due/missed in 14 days and mark trends per student. Runs at
# EARLY_WARNING_PUSH_AT (Africa/Kigali, default 18:45) and ~2 min after boot
# when the last success is over 20 h old. Set EARLY_WARNING_PUSH=0 to stop it.
EARLY_WARNING_PUSH=1
EARLY_WARNING_PUSH_AT=18:45

# AI provider fallback — every AI feature in the app (grading, quiz generation,
# Socratic hints, test case generation, feedback, lesson summaries, document-based
# question generation, and the Database Management AI SQL panel) goes through this
# same chain via src/services/aiProviders. Set whichever keys you have; providers are
# tried left-to-right and fall through automatically on error/quota.
AI_PROVIDER_ORDER=openai,gemini,groq,deepseek,openrouter,glm

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenRouter (https://openrouter.ai/keys): FREE models only. Comma-separated fallback list; ids
# without ":free" (other than openrouter/free) are ignored. 50 requests/day per account without credits.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free

# File storage - shared file-server service (lives in ../../nga_central_mis/file-server).
# Run it locally too (cd file-server && npm run dev) for uploads to work in
# dev; the key must match file-server's own .env.
FILE_SERVER_URL=http://127.0.0.1:5004
FILE_SERVER_API_KEY=your_local_file_server_key_here

# Code execution (Judge0). Self-hosted: JUDGE0_URL=http://judge-host:2358 and
# no key. RapidAPI: JUDGE0_URL=https://judge0-ce.p.rapidapi.com + key.
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
# Retries on 429/5xx/network errors (exponential backoff from the base delay)
JUDGE0_MAX_RETRIES=3
JUDGE0_RETRY_BASE_MS=500
# Re-grade answers left pending while the judge was down (minutes, 0 = off)
CODE_REGRADE_INTERVAL_MIN=10
# "Run" / "Run tests" per user per minute
CODE_RUN_RATE_LIMIT_PER_MIN=10

# Safe Exam Browser (lockdown_browser): public origin of this API as SEB sees
# it, used to verify X-SafeExamBrowser-ConfigKeyHash behind a proxy. When
# unset, X-Forwarded-Proto/Host are used.
SEB_PUBLIC_ORIGIN=

# Code runner engine for grading and runs: judge0 (above) or tmjudge (our own
# sandboxed judge, nga-tmcode/services/judge, private network only).
CODERUNNER_ENGINE=judge0
TMJUDGE_URL=http://127.0.0.1:5010
TMJUDGE_TOKEN=

# TMCode desktop app: the API origin put in tmcode:// launch links (must be
# on TMCode's allow-list). When unset, X-Forwarded-Proto/Host are used.
TMCODE_API_ORIGIN=
# Grading queue poll interval (ms)
TMCODE_WORKER_INTERVAL_MS=2000

# TMCode Projects (PROJECTS_PLAN.md): quotas and storage. Blobs smaller than
# PROJECTS_BLOB_DB_MAX_KB stay in MySQL; larger ones go to the file-server
# (dev falls back to MySQL when the file-server isn't running).
PROJECTS_MAX_PROJECT_MB=100
PROJECTS_MAX_FILES=5000
PROJECTS_MAX_FILE_MB=10
PROJECTS_MAX_PER_USER=50
PROJECTS_BLOB_DB_MAX_KB=256
# A device with no heartbeat for this long shows offline; SSE heartbeat interval
PROJECTS_PRESENCE_STALE_S=60
PROJECTS_SSE_HEARTBEAT_MS=25000
# Lifetime of the TMCode user token from POST /api/tmcode/auth/exchange
TMCODE_USER_TOKEN_TTL_DAYS=30
