{
  "id": "/",
  "name": "Task Mentor — NGA",
  "short_name": "Task Mentor",
  "description": "Assessments, quizzes, exams and report cards for New Generation Academy.",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#3b82f6",
  "background_color": "#ffffff",
  "categories": [
    "education",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "related_applications": [
    { "platform": "webapp", "url": "/manifest.webmanifest", "id": "https://taskmentor.amashuri.com/" }
  ]
}
