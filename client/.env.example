# TaskMentor client — copy to .env. Vite reads it at dev-server start.

# The server from ../server (npm run dev)
VITE_API_BASE_URL=http://localhost:5002
# Live proctoring sockets (../live-server, only needed for the proctoring module)
VITE_SOCKET_URL=http://localhost:5003

# ── NGA Central MIS sign-in ──
# Where users are sent to authenticate; must match the server's SSO_CLIENT_ID.
VITE_MIS_LOGIN_URL=https://mis.amashuri.com/login
VITE_SSO_CLIENT_ID=taskmentor_dev
