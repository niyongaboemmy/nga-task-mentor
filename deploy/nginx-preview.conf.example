# Preview origin for students' web servers (CODE_RUNNER_PLAN.md phase 5).
#
# A SEPARATE origin on purpose: student pages never run on
# taskmentor.amashuri.com, so they can't read its storage or tokens.
# Task Mentor hands out signed addresses on this origin
# (/p/<preview>/<exp>.<sig>/…); tm-judge checks the signature itself.
#
# Free setup on the app host:
#   1. DNS: an A record  preview.amashuri.com -> the app host's public IP.
#   2. Copy this file to /etc/nginx/sites-available/preview.conf, link it into
#      sites-enabled, `sudo nginx -t && sudo systemctl reload nginx`.
#   3. TLS: `sudo certbot --nginx -d preview.amashuri.com` (free, Let's Encrypt).
#   4. In /opt/apps/tm-judge/.judge.env (read by Task Mentor's deploy):
#        JUDGE_PREVIEW_BASE=https://preview.amashuri.com
#        JUDGE_PREVIEW_SECRET=<the same 32+ character secret as the runner's>
#   The runner is reached over the WireGuard tunnel (10.66.0.2) when it runs
#   on the free Oracle VM, or on 127.0.0.1 when it runs on this host.

server {
    listen 80;
    server_name preview.amashuri.com;

    # Only the signed preview paths; everything else is refused.
    location / {
        return 404;
    }

    location /p/ {
        proxy_pass http://10.66.0.2:5010;   # or http://127.0.0.1:5010
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade_or_close;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Never forward Task Mentor or MIS cookies to student code.
        proxy_set_header Cookie "";
        proxy_read_timeout 300s;
        proxy_buffering off;
        client_max_body_size 5m;
    }
}

# Needed once in the http block (e.g. /etc/nginx/conf.d/upgrade.conf):
# map $http_upgrade $connection_upgrade_or_close { default upgrade; "" close; }
